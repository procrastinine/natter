{
  "name": "natter",
  "version": "0.0.0",
  "private": true,
  "description": "A browser-only chat UI for OpenAI-compatible LLM APIs.",
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "dev": "exec vite",
    "build": "tsc -b && vite build",
    "preview": "exec vite preview",
    "test": "exec vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome lint .",
    "lint:semantic": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.config.ts\"",
    "deadcode": "knip --no-progress",
    "deps:unused": "knip --dependencies --no-progress",
    "deps:cruise": "depcruise src --config .dependency-cruiser.cjs",
    "duplication": "jscpd --config jscpd.config.json src tests",
    "audit:static": "pnpm deps:unused && pnpm lint:semantic && pnpm deps:cruise && pnpm duplication",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-virtual": "^3.13.24",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.2",
    "katex": "^0.16.45",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "streamdown": "^2.5.0",
    "ulidx": "^2.4.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@swc/core": "^1.15.33",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.3.0",
    "fake-indexeddb": "^6.2.5",
    "jscpd": "^4.1.0",
    "jsdom": "^29.1.1",
    "knip": "^6.12.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
