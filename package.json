{
  "name": "natter",
  "version": "0.0.0",
  "private": true,
  "description": "A browser-only chat UI for OpenAI-compatible LLM APIs.",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-dist.mjs",
    "build:pages": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --project=chromium tests/e2e/first-run-seed.spec.ts tests/e2e/send-flow.spec.ts tests/e2e/persistence.spec.ts tests/e2e/concurrent-ops.spec.ts tests/e2e/orphan-recovery.spec.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome lint .",
    "lint:semantic": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.config.ts\"",
    "deadcode": "knip --no-progress",
    "deps:unused": "knip --dependencies --no-progress",
    "deps:outdated": "pnpm outdated",
    "deps:audit": "pnpm audit --audit-level moderate",
    "deps:peers": "pnpm peers check",
    "deps:refresh": "node scripts/deps-refresh.mjs",
    "deps:cruise": "depcruise src --config .dependency-cruiser.cjs",
    "duplication": "jscpd --config jscpd.config.json src tests",
    "perf:stream": "node scripts/profile-fake-stream.mjs",
    "perf:stream:concurrent": "node scripts/profile-concurrent-fake-stream.mjs",
    "perf:delivery": "node scripts/measure-delivery.mjs",
    "perf:report": "node scripts/report-performance-baseline.mjs",
    "audit:static": "pnpm deps:unused && pnpm lint:semantic && pnpm deps:cruise && pnpm duplication",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome check ."
  },
  "dependencies": {
    "@shikijs/langs": "^3.23.0",
    "@shikijs/themes": "^3.23.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-virtual": "^3.14.5",
    "dexie": "^4.4.4",
    "fflate": "^0.8.3",
    "katex": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "scheduler": "^0.27.0",
    "shiki": "^3.23.0",
    "streamdown": "^2.5.0",
    "ulidx": "^2.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/scheduler": "^0.26.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.6.0",
    "fake-indexeddb": "^6.2.5",
    "jscpd": "^5.0.12",
    "jsdom": "^29.1.1",
    "knip": "^6.25.0",
    "tailwindcss": "^4.3.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
